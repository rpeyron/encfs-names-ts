{
  "name": "encfs-filename-codec",
  "version": "0.1.0",
  "description": "Browser-compatible TypeScript codec for EncFS legacy filename encryption",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "encfs",
    "filename-encryption",
    "codec",
    "webcrypto",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src/",
    "src/",
    "README.md",
    "encfs-algo.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
